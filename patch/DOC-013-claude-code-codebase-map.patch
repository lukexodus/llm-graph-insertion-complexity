+
+load_existing_results(jsonl_path):
+    if missing: return {}
+    read each non-empty line; parse JSON; map key -> record
+    skip malformed lines
+
+sample_heldout_nodes(graph, corpus_name, seed, metacademy_sample_size):
+    all_nodes <- sorted(graph.nodes())
+    if "metacademy" in corpus_name.lower():
+        rng <- Random(seed)
+        k <- min(metacademy_sample_size, len(all_nodes))
+        return sorted(rng.sample(all_nodes, k))
+    return all_nodes
+
+_load_existing_keys(raw_jsonl, retry_failed=False):
+    skipped <- set()
+    for key, rec in load_existing_results(raw_jsonl):
+        if rec.status == "success": skipped.add(key)
+        elif rec.status in ("failed","error") and not retry_failed: skipped.add(key)
+    return skipped
+
+compute_metric_stats(values):
+    if empty: return {mean:0, median:0, std:0, min:0, max:0}
+    return mean, median, sample stdev (0 if n<2), min, max
+
+write_manifest(output_dir, config, strategy_config, decision_step):
+    mkdir output_dir
+    gather git info, library versions, model/prompt metadata
+    build data dict (run id, timestamp, mode, provenance, config,
+                     sizes/sample size, repeats, dry_run)
+    write sanitize_metadata(data) as indented JSON
+
+generate_summary_csv(jsonl_path, csv_path, mode):
+    read latest record per key
+    group by (strategy, corpus) for accuracy or (strategy, size) for sweep
+    for each group:
+        count trials/successes/failures/retries
+        mean n_before over successes
+        stats for timing keys
+        stats for zero-retry total_s
+        stats for harness_wall_s and unaccounted_s
+        mean/median/sum/min/max for llm_calls, shortlist_size, embedding_calls
+        if accuracy: rebuild NodeScore objects from records and aggregate
+    write CSV with union of keys
+```
+
+**Pseudocode: `estimate_and_print_plan`**
+
+```
+estimate_and_print_plan(config, strategy, corpora=None, name_source=None):
+    print header
+    if mode == accuracy:
+        if corpora not supplied: load DSA and Metacademy
+        for each corpus:
+            nodes <- graph size
+            sample_k <- min(metacademy_sample_size, nodes) for Metacademy,
+                        else nodes
+            trials <- sample_k * repeats
+            max_cands <- candidate_upper_bound(strategy, nodes - 1)
+            max_llm <- trials * max_cands
+            print and append detail
+    elif mode == sweep:
+        require name_source
+        for each size:
+            max_cands <- candidate_upper_bound(strategy, size)
+            max_llm <- trials_per_size * max_cands
+            print and append detail
+    print totals; return plan
+```
+
+**Pseudocode: `run_accuracy_experiment`**
+
+```
+run_accuracy_experiment(config, strategy_factory, decision_step,
+                        embedder_factory, corpora=None, warmup_fn=None,
+                        progress_callback=None):
+    if not dry_run and not confirm: RuntimeError
+    resolve output dir, raw.jsonl, summary.csv
+    load DSA + Metacademy if corpora not supplied
+    probe <- strategy_factory(); capture name + config
+    if dry_run:
+        plan <- estimate_and_print_plan(...); write_manifest(...); return plan
+    write_manifest(...)
+    if warmup_fn: warmup_fn()
+    skipped <- existing keys if resume else empty
+    llm_meter <- extract MeteredLLMClient
+    planned keys <- all (corpus, held-out node, repeat) keys
+    total_trials <- planned keys not skipped
+    open raw.jsonl in append mode
+    for each corpus in corpora:
+        for rep in repeats:
+            for h in sampled nodes:
+                key <- accuracy key
+                if key in skipped: continue
+                if max_llm_calls reached: summary; return "max_llm_calls_reached"
+                G' <- gold graph.without_node(h)
+                strategy <- strategy_factory()
+                meter <- MeteredEmbedder(embedder_factory())
+                try: strategy.setup(G', meter)
+                except: write failed record; summary; raise
+                gc.collect()
+                snap_before <- llm_meter.snapshot() if present
+                t0 <- now()
+                try:
+                    res <- insert_node(strategy, G', decision_step, h, meter)
+                    wall <- now() - t0
+                    unaccounted <- wall - res.metrics.total_s - res.metrics.validate_s
+                    delta <- snapshot_after - snap_before
+                    cumulative_llm_calls += res.metrics.llm_calls
+                    score <- score_node_insertion(...)
+                    write success record; flush; progress_callback
+                except LLMTransportError:
+                    write failed record; flush; progress_callback
+                    if fail_fast: summary; raise
+                except Exception:
+                    write failed record; flush; progress_callback
+                    summary; raise
+    summary; return completed
+```
+
+**Pseudocode: `run_sweep_experiment`**
+
+```
+run_sweep_experiment(config, strategy_factory, decision_step,
+                     embedder_factory, name_source, ...):
+    same safety, output, manifest, warmup, resume setup as accuracy
+    for each size n:
+        require pool has >= n+1 names
+        for each trial t:
+            key <- sweep key
+            if skipped: continue
+            if max_llm_calls reached: summary; return
+            trial_seed <- seed + n*1000 + t
+            sampled <- Random(trial_seed).sample(pool, n+1)
+            G <- names-only graph over sampled[:n],
+                 domain_context = name_source.domain_context
+            strategy <- fresh; meter <- MeteredEmbedder(fresh embedder)
+            strategy.setup(G, meter)
+            gc.collect()
+            snap_before <- ...
+            t0 <- now()
+            try:
+                res <- insert_node(strategy, G, decision_step, sampled[n], meter)
+                wall; unaccounted; delta; cumulative calls
+                write success record; flush; progress
+            except LLMTransportError: write failed; if fail_fast: summary, raise
+            except Exception: write failed; summary; raise
+    summary; return completed
+
+run_experiment(...):
+    dispatch to accuracy or sweep; sweep requires name_source
+```
+
+**Trial isolation.** Every trial gets (a) a fresh graph copy or names-only
+graph, (b) a fresh strategy instance, (c) a fresh raw embedder wrapped in a
+new `MeteredEmbedder`, and (d) `gc.collect()` before the timed window. Setup
+cost is excluded from the trial timer; only `insert_node` is timed.
+
+---
+
+### 4.13 Strategy implementations
+
+All strategies implement the same lifecycle. The table summarises behaviour;
+per-file pseudocode follows.
+
+| Strategy | `uses_embeddings` | `max_candidates` | Shortlist rule | Update rule |
+|---|---|---|---|---|
+| `null` | False | `min(k, n)` | random k from sorted nodes | no-op |
+| `stub` | False | `min(top_k, n)` | first `top_k` sorted nodes | no-op |
+| `brute_force` | False | `n` | every existing node, sorted | no-op |
+| `embedding_threshold` | True | fallback `n` | all nodes with cosine `> theta`, sorted by `(-score, name)` | append cached vector to matrix |
+| `ann_retrieval` | True | `min(k, n)` | FAISS HNSW top-k, sorted by `(-score, name)` | add cached vector to index |
+| `bounded_bucket` | True | `min(s_max, n)` | members of home segment, sorted by `(-score, name)` | insert into home segment; split if overflow |
+
+#### 4.13.1 `strategies/null.py`
+
+| Symbol | Line | Contract |
+|---|---:|---|
+| `NullStrategy` | 28 | random-k control, no embeddings |
+| `.__init__` | 50 | store seed/k; `_embedder = None` |
+| `.setup` | 58 | bind graph; deliberately discard embedder |
+| `.shortlist` | 73 | sorted nodes, re-seeded sample of k |
+| `.on_inserted` | 97 | no-op |
+| `.config` | 100 | `{seed, k}` |
+| `.diagnostics` | 104 | `{k, candidate_count}` |
