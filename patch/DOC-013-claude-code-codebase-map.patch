+```
+check_applicability(strategy_name, param_name):
+    if param unknown: return True
+    return strategy_name in PARAM_APPLICABILITY[param]
+
+build_strategy_slug(strategy_name, config):
+    parts <- []
+    embedding_threshold -> ["theta{theta}"]
+    ann_retrieval       -> ["k{k}", "ef{ef_search}"]
+    bounded_bucket      -> ["smin{s_min}", "smax{s_max}", "nb{n_bits}"]
+    null                -> ["k{k}"]
+    stub                -> ["k{top_k or k}"]
+    brute_force         -> []
+    else: ValueError
+    if seed present and seed != 42: append "seed{seed}"
+    return "_".join(parts)
+
+derive_default_run_id(mode, strategy, config):
+    slug <- build_strategy_slug(...)
+    return f"{mode}_{strategy}_{slug}" if slug else f"{mode}_{strategy}"
+```
