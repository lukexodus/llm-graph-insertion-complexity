+        corpus2 = load_corpus("DSA_gold_standard_MEKG", root=dataset_root)
+
+        assert list(corpus1.graph.nodes()) == list(corpus2.graph.nodes())
+        assert set(corpus1.graph.edges()) == set(corpus2.graph.edges())
